<mujoco model="dog_mjx">
  <!-- ============================================================
  MJX（JAX GPU）变体，基于 dog_positional.xml（2026-09-26 决策6）。
  同一套几何/质量/执行器参数，MJX 兼容性适配（实测确认）：
    1. 摩擦锥【保留 elliptic impratio=100】：3.13 版 MJX 已原生支持椭圆锥，
       probe 矩阵实测改金字塔锥会导致 RR_hip 站立偏 4.7°、高度低 1cm
       （impratio=100 的近零侧向摩擦是点足设定，不可丢）
    2. 积分器 → implicitfast（MJX 推荐；与 Euler 站立轨迹实测等价，
       长批量 rollout 数值更稳；CPU 一致性校验同 XML 同积分器）
    3. 碰撞体 cylinder → capsule（size/pos/quat 不变，包膜略大）
    4. 足端【保留 condim=6】：3.13 实测支持（站立 base_z 0.2722，比 condim=3
       的 0.2744 更贴近原模型 0.2725；滚动摩擦 0.01 虽小但不丢）
    5. 删除 sensor 段（MJX 训练不用，obs 直接从 data 构造）
  put_model 零 warning：frictionloss/margin/actuatorfrcrange 3.13 均原生支持。
  mesh 全为纯视觉（contype=0），碰撞全是基本体。
  ============================================================ -->
  <compiler angle="radian" meshdir="assets" autolimits="true" />

  <option cone="elliptic" impratio="100" integrator="implicitfast" timestep="0.002" />
  <default>
    <default class="dog">
      <geom friction="0.4" margin="0.001" condim="1"/>
      <joint axis="0 1 0" damping="0.1" armature="0.01" frictionloss="0.2"/>
      <default class="abduction">
        <joint axis="1 0 0" range="-1.0472 1.0472"/>
      </default>
      <default class="hip">
        <default class="front_hip">
          <joint range="-1.5708 3.4907"/>
        </default>
        <default class="back_hip">
          <joint range="-0.5236 4.5379"/>
        </default>
      </default>
      <default class="knee">
        <joint range="-2.7227 -0.83776"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
        <default class="foot">
          <geom size="0.022" pos="-0.002 0 -0.213" priority="1" condim="6" friction="0.9 0.02 0.01"/>
        </default>
      </default>
    </default>
  </default>
  <asset>
    <mesh name="base" file="base.STL"/>
    <mesh name="FL_hip" file="FL_hip.STL"/>
    <mesh name="L_thigh" file="L_thigh.STL"/>
    <mesh name="calf" file="calf.STL"/>
    <mesh name="foot" file="foot.stl"/>
    <mesh name="FR_hip" file="FR_hip.STL"/>
    <mesh name="R_thigh" file="R_thigh.STL"/>
    <mesh name="RL_hip" file="RL_hip.STL"/>
    <mesh name="RR_hip" file="RR_hip.STL"/>
  </asset>

